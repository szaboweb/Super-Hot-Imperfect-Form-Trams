*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Blender / Aseprite backups and raw renders
*.blend1
*.blend2
art/aseprite/export/*_raw/
*.aseprite~

# Secrets and signing keys
.env
.env.*
*.keystore
*.jks
*.pem
*.key
*.pfx
*.p12
secrets/

# Business-confidential material (contracts, finance, store deals, keys lists)
private/
business/

# Documentation is local-only (game development notes); only README.md is committed
docs/
AGENTS.md

# Release outputs
distribution/steam/**/output/
distribution/steam/**/*.log
/*.zip

# Editor settings
.vscode/

# Local AI agent skills (vibe-coding guardrails), not shared
.github/skills/
.github/hooks/

# Temporary files and local helper/one-off scripts (agents: put them here, not in tracked folders)
tmp/
scripts/
*.tmp
*.bak
*.orig

# Source art and distribution/store material is not part of the public case study
art/
distribution/
